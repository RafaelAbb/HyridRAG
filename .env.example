# ── Copy this file to .env and fill in your real values ──────────────────────
# .env is git-ignored. This file (.env.example) IS committed — it shows
# teammates which keys are required without exposing any secrets.

# ── LLM Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...            # required
ANTHROPIC_API_KEY=sk-ant-...     # optional fallback

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# ── ChromaDB (dense index) ────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=rag_docs

# ── Retrieval knobs ───────────────────────────────────────────────────────────
DENSE_TOP_K=10
SPARSE_TOP_K=10
RERANKER_TOP_K=5
RRF_DENSE_WEIGHT=0.7
RRF_SPARSE_WEIGHT=0.3
SIMILARITY_DEDUP_THRESHOLD=0.95

# ── Generation ────────────────────────────────────────────────────────────────
GENERATION_MODEL=gpt-4o
GENERATION_TEMPERATURE=0.0
MAX_TOKENS=1024

# ── Chunking ──────────────────────────────────────────────────────────────────
DEFAULT_CHUNK_STRATEGY=recursive   # fixed | recursive | semantic
CHUNK_SIZE=512
CHUNK_OVERLAP=64
