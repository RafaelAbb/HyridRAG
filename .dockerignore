# Secrets — never enter the build context, let alone the image
.env

# Virtual environments — the image builds its own via requirements.txt
.venv/
venv/
env/
myenv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Git metadata — irrelevant to the running app, and can be large
.git/
.gitignore

# Runtime data — regenerated by the app, mounted in via a volume instead
data/

# Eval artifacts, exercises, docs — not needed to run the service
evals/
exercises/
future/
tests/
*.md

# Frontend — backend image doesn't need it; frontend has its own Dockerfile + .dockerignore
frontend/

# Editor / OS cruft
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
*.egg-info/
